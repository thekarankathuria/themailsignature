                    { dept: "Legal & Compliance", style: "Standard layout + GDPR clause" },
                  ].map((x, idx) => (
                    <div key={idx} className="flex justify-between items-center text-[10px] border-b border-ink-100 dark:border-ink-800 last:border-0 pb-1.5 last:pb-0">
                      <span className="font-bold text-ink-900 dark:text-white">{x.dept}</span>
                      <span className="text-ink-400 text-[9px]">{x.style}</span>
                    </div>
                  ))}
                </div>
              </div>
            </Reveal>

          </div>
        </div>
      </section>

      {/* Why Teams Choose Stats */}
      <section className="mx-auto max-w-[1200px] px-5 py-24 sm:px-8">
        <div className="text-center max-w-xl mx-auto flex flex-col items-center">
          <Reveal>
            <h2 className="text-3xl md:text-4xl font-bold tracking-tight text-ink-900 dark:text-white leading-tight">
              Why Teams Choose Task Pilot
            </h2>
          </Reveal>
          <Reveal delay={0.1}>
            <p className="mt-4 text-base text-ink-500 dark:text-ink-400">
              High performance metrics driven by professional branding on every outgoing corporate mail.
            </p>
          </Reveal>
        </div>

        <div className="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {[
            { stat: "4.8%", title: "Marketing Banner CTR", desc: "Average click-through rate on interactive promotional banners." },
            { stat: "3x", title: "Faster Onboarding Setup", desc: "Sync department templates in bulk using automated directories." },
            { stat: "100%", title: "Brand Compliance", desc: "Signatures are locked dynamically across all office environments." },
            { stat: "10k+", title: "Active Enterprises", desc: "Companies managing custom email signatures globally." },
          ].map((item, i) => (
            <Reveal
              key={item.title}
              delay={i * 0.05}
              className="bg-white dark:bg-ink-900 border border-ink-200/60 dark:border-ink-800/60 rounded-2xl p-6 shadow-xs hover:shadow-md transition-all"
            >
              <div className="text-3.5xl font-extrabold text-taskgo-600 dark:text-taskgo-400">{item.stat}</div>
              <h4 className="text-sm font-bold text-ink-900 dark:text-white mt-4">{item.title}</h4>
              <p className="text-xs text-ink-500 dark:text-ink-400 mt-2 leading-relaxed">{item.desc}</p>
            </Reveal>
          ))}
        </div>
      </section>

      {/* How it Works Section */}
      <section className="border-t border-ink-200/50 bg-white dark:border-ink-800/50 dark:bg-ink-950 py-24">
        <div className="mx-auto max-w-[1200px] px-5 sm:px-8">
          <div className="text-center max-w-xl mx-auto flex flex-col items-center">
            <Reveal>
              <h2 className="text-3xl md:text-4xl font-bold tracking-tight text-ink-900 dark:text-white leading-tight">
                Get Started In Just 3 Easy Steps
              </h2>
            </Reveal>
            <Reveal delay={0.1}>
              <p className="mt-4 text-base text-ink-500 dark:text-ink-400">
                Get started in just 3-easy steps with a guided onboarding experience designed for speed and simplicity.
              </p>
            </Reveal>
          </div>

          <div className="mt-16 grid gap-10 lg:grid-cols-3">
            {[
              {
                num: "01",
                title: "Choose a Template Layout",
                desc: "Select from our range of 8+ corporate, tested signature layouts designed for Word's email engine.",
              },
              {
                num: "02",
                title: "Style & Personalize Design",
                desc: "Add your corporate logos, connect your booking links, and lock color accents to fit brand guidelines.",
              },
              {
                num: "03",
                title: "Deploy Globally or Copy",
                desc: "Sync directly to GSuite & Office 365, or click copy to paste the HTML in under a minute.",
              },
            ].map((step, idx) => (
              <Reveal
                key={step.num}
                delay={idx * 0.05}
                className="bg-ink-50 dark:bg-ink-900 border border-ink-200/50 dark:border-ink-800/50 rounded-2xl p-6 relative flex flex-col gap-4"
              >
                <div className="h-10 w-10 rounded-full bg-taskgo-100 text-taskgo-700 dark:bg-taskgo-950/60 dark:text-taskgo-400 font-bold text-sm flex items-center justify-center">
                  {step.num}
                </div>
                <div>
                  <h3 className="text-base font-bold text-ink-900 dark:text-white leading-tight">{step.title}</h3>
                  <p className="text-xs text-ink-500 dark:text-ink-400 mt-2 leading-relaxed">{step.desc}</p>
                </div>
              </Reveal>
            ))}
          </div>
        </div>
      </section>

      {/* Testimonials Success Stories */}
      <section id="testimonials" className="mx-auto max-w-[1200px] px-5 py-24 sm:px-8">
        <div className="text-center max-w-xl mx-auto flex flex-col items-center">
          <Reveal>
            <h2 className="text-3xl md:text-4xl font-bold tracking-tight text-ink-900 dark:text-white leading-tight">
              Real Results, Real Impact. <br />
              Our Success Stories
            </h2>
          </Reveal>
          <Reveal delay={0.1}>
            <p className="mt-4 text-base text-ink-500 dark:text-ink-400">
              See how IT directors and marketing teams use TaskGo to enforce brand alignment.
            </p>
          </Reveal>
        </div>

        <div className="mt-16 grid gap-6 md:grid-cols-3">
          {[
            {
              quote: "TaskGo has transformed how our team manages brand consistency. With 120+ employees, keeping signatures compliant used to be a nightmare.",
              author: "Sarah Jenkins",
              role: "VP of Product, TechCorp",
              img: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=80&q=80",
              stars: 5,
            },
            {
              quote: "The banner scheduling feature has allowed us to run seasonal marketing campaigns directly inside employee signatures. It has driven significant traffic.",
              author: "David Chen",
              role: "Marketing Lead, FlowAgency",
              img: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=80&q=80",
              stars: 5,
            },
            {
              quote: "Clean, responsive, and works perfectly in Outlook for Windows. The Google Workspace directory sync was set up in under 5 minutes.",
              author: "Elena Rostova",
              role: "Operations Director, StudioNine",
              img: "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&fit=crop&w=80&q=80",
              stars: 5,
            },
          ].map((test, i) => (
            <Reveal
              key={test.author}
              delay={i * 0.05}
              className="bg-white dark:bg-ink-900 border border-ink-200/60 dark:border-ink-800/60 rounded-2xl p-6 shadow-sm flex flex-col justify-between"
            >
              <div>
                <div className="flex gap-0.5 text-amber-400 mb-4">
                  {Array.from({ length: test.stars }).map((_, idx) => (
                    <Star key={idx} size={16} weight="fill" />
                  ))}
                </div>
                <p className="text-sm italic text-ink-700 dark:text-ink-300 leading-relaxed font-medium">
                  &ldquo;{test.quote}&rdquo;
                </p>
              </div>

              <div className="flex items-center gap-3 mt-6 pt-4 border-t border-ink-100 dark:border-ink-800/50">
                {/* eslint-disable-next-line @next/next/no-img-element */}
                <img
                  src={test.img}
                  alt={test.author}
                  className="h-9 w-9 rounded-full object-cover shrink-0"
                />
                <div>
                  <h5 className="text-xs font-bold text-ink-900 dark:text-white leading-none">{test.author}</h5>
                  <span className="text-[10px] text-ink-500 dark:text-ink-400 mt-1 inline-block">{test.role}</span>
                </div>
              </div>
            </Reveal>
          ))}
        </div>
      </section>

      {/* CTA / Contact Section */}
      <section id="contact" className="border-t border-ink-200 bg-ink-900 dark:border-ink-800 dark:bg-ink-950 py-20 relative overflow-hidden">
        <div className="absolute inset-0 opacity-10 pointer-events-none">
          <div className="absolute top-10 left-10 w-44 h-44 rounded-full bg-white blur-3xl" />
          <div className="absolute bottom-10 right-10 w-64 h-64 rounded-full bg-taskgo-400 blur-3xl" />
        </div>

        <div className="relative z-10 mx-auto max-w-[800px] px-5 sm:px-8 text-center flex flex-col items-center">
          <h2 className="text-3xl md:text-4xl font-bold tracking-tight text-white leading-tight">
            Ready to Boost Brand Consistency?
          </h2>
          <p className="text-base text-ink-300 mt-4 max-w-[50ch] leading-relaxed">
            Join thousands of enterprises managing professional email signatures globally. Build yours free today.
          </p>

          <div className="w-full max-w-[480px] mt-8 flex flex-col sm:flex-row gap-3">
            <input
              type="email"
              placeholder="Enter your work email"
              className="h-12 flex-1 rounded-full border border-ink-800 bg-ink-950 px-5 text-sm text-white focus:outline-none focus:border-taskgo-500"
            />
            <Link
              href="/generator"
              className="h-12 px-7 rounded-full bg-taskgo-600 text-white font-semibold text-sm hover:bg-taskgo-700 transition-colors shadow-lg shadow-taskgo-600/20 shrink-0 flex items-center justify-center"
            >
              Get Started Free
            </Link>
          </div>

          <div className="flex gap-4 items-center justify-center mt-6 text-xs text-ink-400">
            <span className="flex items-center gap-1"><CheckCircle size={14} className="text-taskgo-500" /> No credit card required</span>
            <span>•</span>
            <span className="flex items-center gap-1"><CheckCircle size={14} className="text-taskgo-500" /> Free custom builder</span>
          </div>
        </div>
      </section>

      <Footer />
    </div>
  );
}
