# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime uploads (hosted images)
/public/u/

# contact form fallback log (written when no mail provider is configured)
/.contact-submissions.log

# visual brainstorming companion (mockups)
/.superpowers/

# layout review sheets
/.review

# local database, outbox and uploads
/data

# Local MCP server config, per machine
.mcp.json
