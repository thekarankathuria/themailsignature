# Absolute origin the site is served from. Used for canonical URLs, the
# sitemap and links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin that hosted signature images are served from. Leave unset to use the
# request origin. These URLs end up inside mail that outlives any redeploy, so
# once this is set in production it must never change.
# NEXT_PUBLIC_ASSET_BASE=https://themailsignature.com

# SQLite database file. Defaults to data/app.db. On the VPS, keep it on a
# persistent volume that is backed up.
# DATABASE_PATH=/srv/themailsignature/data/app.db

# Where uploaded images are stored. Defaults to public/u. On the VPS, point it
# at a persistent volume outside the app directory; app/u/[file] serves it.
# UPLOAD_DIR=/srv/themailsignature/uploads

# Email. Without RESEND_API_KEY every email is written to OUTBOX_DIR
# (default data/outbox) and shown at /dev/outbox in development.
# RESEND_API_KEY=
# MAIL_FROM=TheMailSignature <hello@themailsignature.com>
# OUTBOX_DIR=data/outbox

# Contact form delivery (uses Resend when RESEND_API_KEY is set).
# CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL=noreply@yourdomain.com

# Local test accounts are created by `npm run seed`, which appends
# SCREENSHOT_EMAIL / SCREENSHOT_PASSWORD, TEST_FREE_* and TEST_PRO_* here.

# Illustrative portraits for sample signatures (`npm run portraits`).
# OPENAI_API_KEY=

# Where the browser sends Content-Security-Policy violation reports. The policy
# ships report-only; watch these before switching it to enforcing.
# CSP_REPORT_URI=https://themailsignature.report-uri.com/r/d/csp/reportOnly

# Where uploaded images are served from in production. Signatures already sent
# point at this address, so once it is set it must never change.
# NEXT_PUBLIC_UPLOAD_BASE=https://themailsignature.com

# Backups (`npm run backup`): where they go and how many to keep.
# BACKUP_DIR=/srv/themailsignature/backups
# BACKUP_KEEP=14

# Stripe. Without STRIPE_SECRET_KEY the local test checkout is used instead.
# Create the two products with a monthly and a yearly price each, then put the
# price ids here. The webhook endpoint is /api/billing/webhook.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTH=price_...
# STRIPE_PRICE_PRO_YEAR=price_...
# STRIPE_PRICE_BUSINESS_MONTH=price_...
# STRIPE_PRICE_BUSINESS_YEAR=price_...
