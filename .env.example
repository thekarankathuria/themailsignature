# Absolute origin the site is served from. Used for canonical URLs and sitemap.
NEXT_PUBLIC_SITE_URL=https://themailsignature.com

# Origin that hosted signature images are served from. Leave unset to use the
# request origin. Point this at a CDN once uploads move off the app server.
# These URLs end up inside mail that outlives any redeploy, so once this is set
# in production it must never change.
# NEXT_PUBLIC_ASSET_BASE=https://cdn.themailsignature.com

# Supabase project credentials (Settings > API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to "true" to show the "Continue with Google" button on /login and
# /signup once the Google provider is configured in Supabase. Leave unset —
# the button self-hides to avoid sending users to an "Unsupported provider"
# error page.
# NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true

# Contact form delivery. With no provider key set, validated submissions are
# appended to .contact-submissions.log rather than silently discarded, so
# nothing is lost while the provider is still being chosen.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL=noreply@yourdomain.com   # must be a Resend-verified sender

# Durable image storage. When set, uploaded signature images go to this
# Supabase Storage bucket instead of the local filesystem. Required for any
# host with an ephemeral disk (Vercel, containers) — without it, every
# signature already sent goes blank on the next deploy.
# The bucket must be public-read, with an INSERT policy for `authenticated`.
SUPABASE_STORAGE_BUCKET=signatures
